# ── LLM Cleaning Layer (LangChain-based, provider-agnostic) ──────────────────
# Model spec: provider:model  (see backend/config.py for all options)
LLM_MODEL=google_genai:gemini-2.0-flash

# Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Set to "0" to bypass the LLM cleaning layer entirely (default: "1")
LLM_SCRUB_ENABLED=1

# ── Legacy Groq keys (kept for backward compat; not needed with Gemini) ───────
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=groq:llama-3.3-70b-versatile

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string for local dev. On Render this is set automatically
# via the linked database. Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/panchang

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:3000,http://localhost:5173

# ── Festival snapshot prewarming ─────────────────────────────────────────────
FESTIVAL_SNAPSHOT_PREWARM_ENABLED=1
FESTIVAL_SNAPSHOT_PREWARM_POINTS=28.6139:77.2090;19.0760:72.8777
FESTIVAL_SNAPSHOT_PREWARM_YEARS=1
FESTIVAL_SNAPSHOT_PREWARM_TZ=Asia/Kolkata
FESTIVAL_SNAPSHOT_PREWARM_AYANAMSA=lahiri
